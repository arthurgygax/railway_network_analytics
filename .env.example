# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. Names are documented here; real values never are.

# --- Deutsche Bahn API credentials (developers.deutschebahn.com) ---
# Timetables API: 60 requests/minute on the free plan.
TIMETABLES_CLIENT_ID=
TIMETABLES_API_KEY=

# StaDa station data. Fetched once by scripts/fetch_stada.py, then cached to disk.
STATION_DATA_CLIENT_ID=
STATION_DATA_API_KEY=

# Which stations to poll. Generate with scripts/fetch_stada.py then pick_poll_targets.py.
POLL_TARGETS_PATH=data/raw/stada/poll_targets.json

# Plan cache and change-detection state. Must persist between runs.
STATE_DIR=data/state

# Where JSON Lines output is written.
OUTPUT_DIR=data/out

# fchg carries a ~28h window, so hourly polling has no gaps and a missed cycle self-heals.
POLL_INTERVAL_SECONDS=3600

HTTP_TIMEOUT_SECONDS=60

# 0 = run until stopped. Any positive number exits after that many polls (smoke tests).
MAX_POLLS=0

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# text = human-readable for local dev, json = structured for log aggregation
LOG_FORMAT=text

# --- Aiven Kafka (Phase 4). Topic carries one message per stop observation. ---
KAFKA_TOPIC=railway.db.stop_observations
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT=certs/ca.pem
